#!/bin/bash
#SBATCH -c 16 --mem=32G --time=2:00:00 -p general-short -C amd24 -o slow-%j.out
cd /mnt/ffs24/home/beyerkyl/cosmo/cosmo_gpu
export NUMBA_NUM_THREADS=16
uv run --locked pytest -q -m slow --durations=5 2>&1 | tail -12
/usr/bin/time -v uv run --locked cosmo-gpu levels 28Si sd usdb -n 10 2>&1 | grep -v -i warn | grep -E "^#|^ |Maximum resident|Elapsed"
uv run --locked cosmo-gpu levels 24Mg sd usdb -n 10 2>&1 | grep -v -i warn
