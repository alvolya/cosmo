#!/bin/bash
# GPU test suite on one GPU. Submit from cosmo_gpu/, e.g.:
#   sbatch --gpus=v100:1 tools/gpu/gpu_tests.sb
#   sbatch --gpus=h200:1 tools/gpu/gpu_tests.sb [extra pytest args]
#SBATCH --job-name=gpu-tests
#SBATCH --partition=general-short
#SBATCH --cpus-per-task=8
#SBATCH --mem=48G
#SBATCH --time=1:00:00
#SBATCH --output=gpu-tests-%j.out
set -euo pipefail
nvidia-smi --query-gpu=name,driver_version,memory.total --format=csv,noheader
export UV_PROJECT_ENVIRONMENT=.venv-gpu NUMBA_NUM_THREADS=$SLURM_CPUS_PER_TASK
uv sync --locked --extra gpu --quiet
uv run --no-sync pytest -q -p no:cacheprovider -m "slow or not slow" --durations=5 tests/test_gpu.py "$@" 2>&1 \
    | grep -v -i "numbawarning\|warnings.warn\|tbb"
