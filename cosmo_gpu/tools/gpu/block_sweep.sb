#!/bin/bash
# Submit from cosmo_gpu/: sbatch --gpus=h200:1 tools/gpu/block_sweep.sb
#SBATCH --job-name=block-sweep
#SBATCH --partition=general-short
#SBATCH --cpus-per-task=16
#SBATCH --mem=96G
#SBATCH --time=1:00:00
#SBATCH --output=block-sweep-%j.out
set -euo pipefail
export UV_PROJECT_ENVIRONMENT=.venv-gpu NUMBA_NUM_THREADS=$SLURM_CPUS_PER_TASK
uv run --no-sync python tools/gpu/block_sweep.py 2>&1 | grep --line-buffered -v -i "numbawarning\|warnings.warn\|tbb"
